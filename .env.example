# Never commit real credentials.
# Official Lighter API docs: https://apidocs.lighter.xyz/docs/api-keys
LIGHTER_BASE_URL=https://testnet.zklighter.elliot.ai
LIGHTER_MODE=paper
LIGHTER_LIVE_TRADING=false
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=
# Credentials never enable live trading; keep them outside source control.

# Strategy/risk defaults
NEWS_MAX_AGE_SECONDS=120
MIN_SIGNAL_SCORE=0.75
MIN_SIGNAL_CONFIDENCE=0.70
MAX_POSITION_NOTIONAL=100
MAX_TOTAL_NOTIONAL=250
MAX_DAILY_LOSS=25
MAX_SPREAD_BPS=50
MAX_VOLATILITY=0.25

# News providers are intentionally configured outside source control.
NEWS_POLL_SECONDS=2
