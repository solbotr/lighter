# B20 Mainnet Bot - Base Mainnet ONLY
# Copy to .env and fill values. Never commit real keys.

RPC_URL=https://mainnet.base.org
# Recommended: paid WS endpoint for reliable event streaming (faster monitoring, lower rate limits)
# RPC_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# Use WS for production sniping to reduce 429 errors and get lower latency.

PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
WALLET_ADDRESS=0xYourAddressHere

# Optional: route some submissions via Flashbots Protect or other private RPC
# Note: Flashbots Protect primarily targets Ethereum; test compatibility for Base.
FLASHBOTS_RPC=https://rpc.flashbots.net

# Live production defaults (DRY_RUN_DEFAULT=true is emergency kill only — not for trading)
DRY_RUN_DEFAULT=false
LIGHTER_LIVE=true
NEWS_PROMOTION_MODE=live
NEWS_FORCE_LIVE=true
NEWS_KILL_SWITCH=false
# TELEGRAM_ADMIN_CHAT_ID=123456789   # required allowlist for Telegram trade commands
# POKE_API_KEY=
# DEBANK_ACCESS_KEY=
# MINI_APP_BIND=127.0.0.1
# GRAFANA_ADMIN_PASSWORD=changeme

# Telegram (ethbot-style setup — highly recommended)
# 1. Create bot: https://t.me/BotFather → /newbot
# 2. Get chat ID: message the bot, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates  → look for "chat":{"id": ...}
#
# Supported names (any of these work):
TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
ADMIN_CHAT_ID=123456789

# Aliases (also accepted)
# BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Legacy (still supported for backward compat)
# TG_BOT_TOKEN=
# TG_USER_ID=

# ===== Lighter DEX News Sniper & Risk Rules =====
NEWS_ENABLED=true
NEWS_REQUESTED_USD=50.0
NEWS_MAX_TRADE_USD=100.0
NEWS_MAX_HIGH_CONVICTION_USD=100.0
NEWS_MAX_ASSET_EXPOSURE_USD=150.0
NEWS_MAX_EXPOSURE_USD=1100.0
# Maximum simultaneous news positions (sized for about $730 collateral).
NEWS_MAX_CONCURRENCY=6
# Maximum gross open plus reserved notional as a multiple of collateral.
NEWS_MAX_GROSS_LEVERAGE=1.5
# Catalyst time stops (minutes): TIER1 listing 240, MACRO 90, PARTNERSHIP 120, OTHER 60.
# Set NEWS_MAX_HOLD_MINUTES to force one value for all; NEWS_MAX_HOLD_DAYS only if you really want multi-day holds.
#NEWS_MAX_HOLD_MINUTES=
# Flatten a live position if exchange TP+SL could not be attached after PROTECT_ATTACH_RETRIES (default on).
NEWS_CLOSE_IF_UNPROTECTED=1
PROTECT_ATTACH_RETRIES=5
NEWS_MIN_CONFIDENCE=0.75
NEWS_RISK_PER_TRADE_PCT=1.0
# Optional comma-separated source IDs that may trade live; blank uses adapter allowlist only.
NEWS_LIVE_SOURCE_IDS=
# Fast source adapters allowed to trade live; polled RSS/Google News remains shadow-only.
NEWS_LIVE_SOURCE_ADAPTERS=treenews_ws,webhook,official,x
# Reject taker snipes whose publication-to-ingestion latency exceeds this many seconds.
NEWS_MAX_FEED_LATENCY_SEC=20
NEWS_ASSET_COOLDOWN_SECONDS=900.0
NEWS_AUTO_TRADE_CONFIRMED_ONLY=true
NEWS_ENFORCE_ONCHAIN_DECIMALS=true
NEWS_ZERO_DECIMAL_INTEGER_ONLY=true
NEWS_SUB_DOLLAR_DIVISOR_PROTECTION=true
NEWS_KILL_SWITCH=false

# ===== zkLighter Account Tier & Fee Calibration =====
# Standard: 0 bps maker / 0 bps taker (300 ms). Premium: 0.4 bps maker / 2.8 bps taker (200 ms).
# Run the market maker on a STANDARD subaccount (see MM_DEPLOY.md); Premium only pays off for latency-sensitive taker snipes.
LIGHTER_TIER=PREMIUM
LIGHTER_MAKER_FEE_PCT=0.0040
LIGHTER_TAKER_FEE_PCT=0.0280

# ===== Market maker child process (watchdog_supervisor.py) — see MM_DEPLOY.md =====
# Off by default: the MM needs its own STANDARD-tier subaccount and its own key.
MM_ENABLED=0
MM_BOT_ARGS=--live
#LIGHTER_MM_ACCOUNT_INDEX=
#LIGHTER_MM_API_KEY_INDEX=
#LIGHTER_MM_API_PRIVATE_KEY=
#LIGHTER_MM_DB_PATH=
# Keep off unless the MM uses a *different* Telegram token than the sniper (two getUpdates pollers conflict).
MM_ENABLE_TELEGRAM=0
LIGHTER_MAKER_FEE_BPS=0.40
LIGHTER_TAKER_FEE_BPS=2.80
LIGHTER_TAKER_LATENCY_MS=200.0
LIGHTER_STAKED_LIT=0

# Run the diagnostic:
#   python tg_diag.py
# It will test getMe, clear webhook if needed, and send a test message.

# Live trading risk controls (use small values when starting)
MAX_TRADE_ETH=0.1
MAX_DAILY_LOSS_ETH=0.5
MIN_LIQUIDITY_ETH=5.0
SLIPPAGE_BPS=2000          # 20% for launches (reduce later)
KILL_SWITCH_FILE=/home/ubuntu/b20-bot/KILL_SWITCH

# ===== Phase 11 upgrades =====

# #73: Hard cap on worst-case gas spend per trade (ETH). 0 disables the cap.
MAX_GAS_ETH_PER_TRADE=0.0015

# #50: Limit orders — how often to check open orders (seconds)
LIMIT_CHECK_SECS=20

# #56: Chunked buys — split entries >= CHUNKED_BUY_MIN_TOTAL into CHUNK_COUNT parts
CHUNKED_BUY_ENABLED=true
CHUNKED_BUY_MIN_TOTAL=0.01
CHUNK_COUNT=3
CHUNK_DELAY_SECS=20

# #58: Bot competition avoidance — skip snipes when known bots race the same token
BOT_COMPETITION_CHECK=true
MAX_KNOWN_BOT_COMPETITORS=2
MAX_TOTAL_COMPETING_SWAPS=6
# Comma-separated wallets you know are sniper bots (auto-learning also runs)
KNOWN_BOT_WALLETS=
BOT_LEARN_WINDOW_SECS=10

# #32: Large early sell watchdog — alert if price collapses right after entry
EARLY_SELL_CHECK_SECS=20
EARLY_SELL_WINDOW_SECS=900
EARLY_SELL_DROP_PCT=30

# #91: A/B testing (variant tagging of trades for strategy comparison)
AB_TEST_ENABLED=false

# RPC failover (comma separated) - add as many as you want for reliability during launches
# Public Base Mainnet RPCs (mix HTTP and WS where possible). Use paid ones for production.
# The bot will auto-failover on errors/429s.
BACKUP_RPCS=https://mainnet.base.org,https://base-mainnet.public.blastapi.io,https://base.meowrpc.com,https://base-pokt.nodies.app,https://rpc.ankr.com/base,https://base.drpc.org,https://1rpc.io/base,https://base.blockpi.network/v1/rpc/public,https://base.api.onfinality.io/public,https://gateway.tenderly.co/public/base,https://base.llamarpc.com,https://base.rpc.subquery.network/public,https://base-rpc.publicnode.com,https://base-mainnet-rpc.allthatnode.com,https://base.publicnode.com,https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY,https://base-mainnet.infura.io/v3/YOUR_INFURA_KEY,https://base.nodereal.io/v1/YOUR_KEY,wss://base-mainnet.public.blastapi.io,wss://base.meowrpc.com
